      "total": {
        "content": "$1"
      },
      "discarded": {
        "content": "$2"
      },
      "candidates": {
        "content": "$3"
      }
    }
  },
  "discardIdle": {
    "message": "Discard idle tabs ($COUNT$)",
    "placeholders": {
      "count": {
        "content": "$1"
      }
    }
  },
  "confirmText": {
